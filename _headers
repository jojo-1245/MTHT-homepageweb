# Cloudflare Pages — 응답 헤더 설정
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  # HSTS — www 는 Cloudflare 가 항상 https 로 서빙한다. preload 는 apex(service-mh.example.invalid, 가비아 포워딩 http 전용) 때문에 넣지 않는다
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  # CSP — 외부 CDN(jquery/tailwind/jsdelivr/cdnjs/fontawesome) + 새 API(*.pages.dev / *.service-mh.example.invalid) 허용.
  # 옛 api-2ceb5f.example.invalid 는 *.service-mh.example.invalid 와일드카드로 자동 포함.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://code.jquery.com https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://kit.fontawesome.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://ka-f.fontawesome.com https://*.fontawesome.com; font-src 'self' data: https://fonts.gstatic.com https://ka-f.fontawesome.com https://*.fontawesome.com; img-src 'self' data: https:; connect-src 'self' https://*.service-mh.example.invalid https://*.pages.dev https://ka-f.fontawesome.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# HTML — 짧게 캐싱 (수정사항 즉시 반영 위해)
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# 정적 자산 — 길게 캐싱 (현재 versioning 없으므로 1일 정도로 보수적)
/assets/*
  Cache-Control: public, max-age=86400

/styles/*
  Cache-Control: public, max-age=86400
